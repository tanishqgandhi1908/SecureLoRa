# ==============================================================================
# SecureLoRa Server Environment Configuration (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Update the passwords and tokens below with strong, unique secrets.
# 3. DO NOT commit .env to version control! It is already ignored by Git.
# ==============================================================================

# --- Gateway Ingest Authentication ---
# The gateway sends: "Authorization: Bearer <GATEWAY_API_TOKEN>"
# Share this token with Tanishq for gateway/include/secrets.h (API_TOKEN)
GATEWAY_API_TOKEN=securelora_gateway_write_token_2026_demo

# --- InfluxDB 2.x Configuration ---
INFLUXDB_USER=securelora_admin
INFLUXDB_PASSWORD=SecureLoRaAdmin2026!Password
INFLUXDB_ORG=securelora
INFLUXDB_BUCKET=readings
INFLUXDB_TOKEN=securelora_influx_super_secret_token_2026_abcdef

# Internal connection URL (used by ingest container and Grafana inside docker network)
INFLUXDB_URL=http://influxdb:8086

# --- Grafana Configuration ---
GRAFANA_USER=dashboard_admin
GRAFANA_PASSWORD=SecureLoRaDashboard2026!Password

# --- Host Exposed Ports ---
HTTP_PORT=8080
HTTPS_PORT=8443
GRAFANA_PORT=3000
INFLUXDB_PORT=8086

# --- Logging & Ingest Tuning ---
LOG_DIR=./logs
STALE_THRESHOLD_SECONDS=180
