# PlatformIO build output
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Secrets: never commit these (copy secrets_example.h -> secrets.h instead)
**/include/secrets.h
.env
**/.env
server/.env

# Server certificates & private keys
server/certs/*.key
server/certs/*.pem
server/certs/*.crt
server/certs/*.srl
server/certs/*.csr

# Server logs and runtime data
server/logs/
*.log
*.jsonl

# Python artifacts
.venv/
__pycache__/
*.pyc

.DS_Store

# HMAC key shared by node + gateway (copy shared/secret_key_example.h)
shared/secret_key.h

# (*.log above also covers serial monitor logs in gateway/logs/; copy 72 h logs to /logs on purpose)
